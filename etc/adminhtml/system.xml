<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../Magento/Config/etc/system_file.xsd">
    <system>
        <tab id="magecomp" translate="label" sortOrder="100" class="magecomp-logo">
            <label><![CDATA[]]></label>
        </tab>
        <section id="countryflag" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>International Telephone Input</label>
            <tab>magecomp</tab>
            <resource>Magecomp_Countryflag::countryflag</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Configuration</label>
                <field id="enable" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>International Telephone Input for Customer Address</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                </field>
                <field id="enable_contact" type="select" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable for Contact Us Form</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="pinned_countries" translate="label comment" type="multiselect" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Pinned Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                    <comment><![CDATA[Select countries to pin at the top of the country flag dropdown.]]></comment>
                </field>
                <field id="blocked_countries" translate="label comment" type="multiselect" sortOrder="28" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Blocked Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                    <comment><![CDATA[Select countries to block/exclude from the country flag dropdown.]]></comment>
                </field>
                <field id="detect_by_ip" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Set country automatically</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Using client IP address]]></comment>
                </field>            
            </group>
            <group id="countryflag" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Phone Number Digit Validation</label>
                <field id="countryvalidate" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                   <label>Country Digits</label>
                   <frontend_model>Magecomp\Countryflag\Block\Adminhtml\Form\Field\Countryvalidate</frontend_model>
                   <comment><![CDATA[Count Digits without Country code.]]></comment>
                   <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                </field>
            </group>
        </section>
    </system>
</config>
