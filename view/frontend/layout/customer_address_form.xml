<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <head>
        <css src="Magecomp_Countryflag/css/intlTelInput.css"/>
    </head>
    <body>
        <referenceBlock name="customer_address_edit">
            <action method="setTemplate" >
                <argument name="template" xsi:type="helper" helper="Magecomp\Countryflag\Helper\Data::getTemplate"></argument>
            </action>
            <action method="setValidation">
                <argument name="telephone" xsi:type="array">
                    <item name="required-entry" xsi:type="boolean">true</item>
                </argument>
            </action>
        </referenceBlock>
    </body>
</page>
